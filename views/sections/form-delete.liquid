<div class="flex items-center justify-between gap-4 mb-4">
  <div>
    <a class="inline-block text-xs text-gray-500 mb-1 hover:text-indigo-700" href="{{ backHref }}">{{ formName }}</a>
    <h1 class="text-2xl font-bold text-gray-900">Delete form</h1>
  </div>
</div>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6" style="max-width:36rem">
  <p class="text-sm text-gray-700 mb-2">Delete <strong>{{ formName }}</strong>?</p>
  <p class="text-sm text-gray-500 mb-4">The form and its {{ submissionCount }} stored submission(s) are moved to trash. The public link stops working after the next publish sync.</p>
  <form method="post" action="{{ action }}">
    <button class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-transparent bg-red-600 px-4 text-sm font-semibold text-white hover:bg-red-700 cursor-pointer" type="submit">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><use href="/assets/icons.svg#trash"></use></svg>
      Delete form
    </button>
    <a class="inline-flex h-10 items-center justify-center px-4 text-sm font-semibold text-gray-700 hover:text-gray-900" href="{{ backHref }}">Cancel</a>
  </form>
</div>
